{
  "name": "videostudio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,web\" -c \"cyan,magenta\" \"npm run dev -w @videostudio/server\" \"npm run dev -w @videostudio/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "node -e \"console.log('Skeleton ready')\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
